+    /** Native Item constructor; supplied Properties already contain its own registry key. */
+    public static synchronized void registerNativeKeyedItemFactory(String owner, String id,
+            java.util.function.Function<Object,Object> factory) {
+        requireOwner(owner);
+        requireId(id);
+        Objects.requireNonNull(factory, "nativeKeyedItemFactory");
+        if (sealed) throw new IllegalStateException("Native item factories closed after bootstrap");
+        Definition definition = DEFINITIONS.get(id);
+        if (definition == null || !definition.owner().equals(owner))
+            throw new IllegalArgumentException("Factory must target an owned registered item: " + id);
+        if (NATIVE_KEYED_ITEM_FACTORIES.putIfAbsent(id, factory) != null)
+            throw new IllegalArgumentException("Duplicate native item factory: " + id);
+    }
+
+    public static synchronized java.util.function.Function<Object,Object> nativeKeyedItemFactory(String id) {
+        return NATIVE_KEYED_ITEM_FACTORIES.get(id);
